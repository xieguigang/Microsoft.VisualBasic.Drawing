<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>16.9</LangVersion>
    <Version>0.2.0</Version>
    <Authors>Roy Triesscheijn, Wouter de Vries</Authors>
    <Company />
    <Product />
    <Title>TrueType Font Parser</Title>
    <Description>A TrueType parser for reading, glyphIds, names, descriptions, and kerning information from TrueType fonts.</Description>
    <PackageReleaseNotes>A TrueType font metadata parser, a VB.NET port of Roy-T.TrueType (https://github.com/roy-t/TrueType). It reads the CMAP (character to glyph index mapping), KERN (inter character kerning), NAME (multilingual font names and styles), MAXP (memory requirements), HMTX / VMTX (horizontal and vertical metrics), HHEA / VHEA (horizontal and vertical header), HEAD, OS/2 and TTC header tables, and supports the segmented mapping to delta values, trimmed table mapping, segmented coverage and byte encoding cmap subtable formats. The library exposes both an easy to use API - TrueTypeFont.FromFile / FromCollectionFile / FromStream together with the GlyphHelper, KerningHelper and NameHelper extensions - and the parsed tables themselves so you can add your own interpretation of the data. This library aims to read meta information from .ttf files, it does not give you enough information to render glyphs yourself.</PackageReleaseNotes>
    <Copyright></Copyright>
    
    <PackageProjectUrl>https://github.com/roy-t/TrueType</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roy-t/TrueType</RepositoryUrl>
    <RepositoryType />
    <PackageTags>truetype, ttf, opentype, font, fonts, parser</PackageTags>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  
    <AssemblyName>Microsoft.VisualBasic.Drawing.Fonts.TrueType</AssemblyName>
    <RootNamespace>Microsoft.VisualBasic.Drawing.Fonts.TrueType</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <UseApplicationFramework>True</UseApplicationFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;nuget_release</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|AnyCPU'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>