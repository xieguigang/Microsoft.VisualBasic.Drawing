<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Drawing</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeSymbols>True</IncludeSymbols>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Configurations>Debug;Release;MEMI-Desktop;nuget_release;CellaLAB-Desktop;Rsharp_app_release</Configurations>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageTags>skiasharp;</PackageTags>
    <PackageOutputPath>../../.nuget</PackageOutputPath>
    <OutputPath>../../.nuget</OutputPath>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>


  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0-preview.1.26454.9" />
    <PackageReference Include="SkiaSharp.Extended" Version="3.1.0-preview.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0-preview.1.26454.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0-preview.1.26454.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.154.0-preview.1.26454.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.154.0-preview.1.26454.9" />
    <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    <PackageReference Include="System.Security.Permissions" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\mime\text%html\html_netcore5.vbproj" />
  </ItemGroup>

</Project>
