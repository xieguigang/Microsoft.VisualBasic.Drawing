<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Drawing</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeSymbols>True</IncludeSymbols>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Configurations>Debug;Release;MEMI-Desktop;nuget_release;CellaLAB-Desktop;Rsharp_app_release</Configurations>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageTags>skiasharp;</PackageTags>
    <PackageOutputPath>../../.nuget</PackageOutputPath>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

